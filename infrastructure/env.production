# =============================================================================
# HomeIQ Production Environment Template
# =============================================================================
# NO REAL VALUES BELONG IN GIT. This file is a production-shaped template:
# scripts/setup-production-env.sh copies it to .env — fill in every empty
# value before starting the stack. Services fail loudly when these are unset.
# See infrastructure/env.example for the full documented variable list.
# =============================================================================

# Epic 40: Deployment Mode Configuration
DEPLOYMENT_MODE=production

# Home Assistant Configuration (REQUIRED)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HA_HTTP_URL=
HA_WS_URL=
HA_URL=
HA_TOKEN=

# MQTT (only if using Zigbee2MQTT / MQTT integrations)
MQTT_BROKER=
MQTT_USERNAME=
MQTT_PASSWORD=

# Nabu Casa Fallback Configuration (optional)
NABU_CASA_URL=
NABU_CASA_TOKEN=

# Local Home Assistant Fallback (Optional)
LOCAL_HA_URL=
LOCAL_HA_TOKEN=

# InfluxDB Configuration
INFLUXDB_URL=http://localhost:8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=
INFLUXDB_ORG=homeiq
INFLUXDB_BUCKET=home_assistant_events
INFLUXDB_TOKEN=

# Weather API Configuration
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Logging Configuration
LOG_LEVEL=INFO

# Shared API key configuration for production services (generate a strong value)
API_KEY=
ADMIN_API_API_KEY=
DATA_API_API_KEY=

# Timezone Configuration
TZ=America/Los_Angeles

# Authentication Configuration
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_PASSWORD=

# Data Retention Configuration
CLEANUP_INTERVAL_HOURS=24
MONITORING_INTERVAL_MINUTES=5
COMPRESSION_INTERVAL_HOURS=24
BACKUP_INTERVAL_HOURS=24
BACKUP_DIR=/backups

# Service Configuration
ENABLE_WEATHER_API=true
ENABLE_AUTH=false

# Epic 40: External API Services - ENABLED in Production
ENABLE_CARBON_INTENSITY=true
ENABLE_ELECTRICITY_PRICING=true
ENABLE_AIR_QUALITY=true
ENABLE_SMART_METER=true
ENABLE_SPORTS_DATA=true

# Epic 40: Data Generation - DISABLED in Production
ENABLE_SYNTHETIC_DATA_GENERATION=false
ENABLE_MOCK_DATA_CREATION=false

# Service Ports
ADMIN_API_PORT=8003
WEBSOCKET_INGESTION_PORT=8001
ENRICHMENT_PIPELINE_PORT=8002
DATA_RETENTION_PORT=8080
HEALTH_DASHBOARD_PORT=3000
WEATHER_API_PORT=8001
INFLUXDB_PORT=8086
HA_SIMULATOR_PORT=8123

# HA Simulator Configuration
SIMULATOR_PORT=8123
SIMULATOR_AUTH_TOKEN=dev_simulator_token
SIMULATOR_HA_VERSION=2025.10.1
SIMULATOR_LOG_LEVEL=INFO

WEATHER_LOCATION=Las Vegas,NV,US
WEATHER_DEFAULT_LOCATION=Las Vegas,NV,US
WEATHER_ENRICHMENT_ENABLED=true
WEATHER_CACHE_MINUTES=15
AIRNOW_API_KEY=

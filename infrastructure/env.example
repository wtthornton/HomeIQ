# =============================================================================
# HomeIQ Environment Template — SINGLE AUTHORITATIVE TEMPLATE
# =============================================================================
# Copy to the repo root as .env and fill in the REQUIRED values:
#     cp infrastructure/env.example .env
#
# Conventions in this file:
#   - REQUIRED vars are uncommented with a placeholder — replace before deploy.
#   - Optional vars are commented out, showing their default value. Leave them
#     commented unless you want to override: an uncommented empty VAR= counts
#     as "set to empty" and overrides compose defaults.
#   - Never commit a filled-in .env. No real secrets belong in git.
# =============================================================================


# =============================================================================
# 1. HOME ASSISTANT CONNECTION (REQUIRED)
# =============================================================================
# *****************************************************************************
# *** THE HA_URL FOOTGUN — READ BEFORE EDITING ***
#
# HA_URL means DIFFERENT things to different services in this repo:
#   - websocket-ingestion and libs/homeiq-ha treat HA_URL as a WEBSOCKET url
#     (ws://host:8123), while
#   - ~20 REST client services treat HA_URL as a plain HTTP base url
#     (http://host:8123).
#
# Therefore ALWAYS set all three explicitly and unambiguously:
#   HA_HTTP_URL  http(s):// form — used by REST clients
#   HA_WS_URL    ws(s):// form   — used by websocket clients
#   HA_URL       set to the SAME value as HA_HTTP_URL (http form)
# *****************************************************************************
HA_HTTP_URL=http://homeassistant.local:8123
HA_WS_URL=ws://homeassistant.local:8123
HA_URL=http://homeassistant.local:8123

# Long-lived access token: HA Profile -> Security -> Long-Lived Access Tokens
HA_TOKEN=

# Legacy aliases still read by several services — keep in sync with the above
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# Master switch for the HA connection (websocket-ingestion)
# ENABLE_HOME_ASSISTANT=true

# Nabu Casa cloud fallback (optional — leave empty if unused)
NABU_CASA_URL=
NABU_CASA_TOKEN=
# NABU_CASA_SSL_VERIFY=true

# Local HA fallback used by connection-manager fallback chain (optional)
# LOCAL_HA_URL=http://localhost:8123
# LOCAL_HA_TOKEN=

# Multi-home identifier (defaults to "default")
# HOME_ID=default

# Token used only by integration test tooling (optional)
# HA_TEST_TOKEN=


# =============================================================================
# 2. INFLUXDB (REQUIRED)
# =============================================================================
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=homeiq
INFLUXDB_BUCKET=home_assistant_events
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=
# INFLUXDB_PORT=8086
# Carbon-intensity data bucket (read by the data-api energy endpoints)
# INFLUXDB_CARBON_BUCKET=carbon_intensity


# =============================================================================
# 3. POSTGRESQL (REQUIRED)
# =============================================================================
POSTGRES_USER=homeiq
POSTGRES_PASSWORD=
# Full DSNs — must agree with POSTGRES_USER/POSTGRES_PASSWORD above
# DATABASE_URL=postgresql+asyncpg://homeiq:<password>@postgres:5432/homeiq
# POSTGRES_URL=postgresql+asyncpg://homeiq:<password>@postgres:5432/homeiq


# =============================================================================
# 4. AUTH / API KEYS (REQUIRED for production)
# =============================================================================
# API_KEY is the shared service key. It fans out to: DATA_API_KEY,
# DATA_API_API_KEY, AI_AUTOMATION_API_KEY, DEVICE_INTELLIGENCE_API_KEY,
# and VITE_API_KEY (dashboard build). Set one strong value here and the
# compose files propagate it; only override the fan-out vars individually
# if a service must use a different key.
API_KEY=
# DATA_API_KEY=
# DATA_API_API_KEY=
# AI_AUTOMATION_API_KEY=
# DEVICE_INTELLIGENCE_API_KEY=
# VITE_API_KEY=

# homeiq-mcp (TAP-5293) — the HomeIQ MCP server on :8050. Read tokens are
# required for HTTP transport; write tokens are optional and must not overlap.
# HOMEIQ_MCP_ALLOWED_HOSTS lists extra Host values accepted besides homeiq-mcp
# and localhost (DNS-rebinding guard) — e.g. the docker host gateway AgentForge
# uses to reach the published port.
HOMEIQ_MCP_READ_TOKENS=
# HOMEIQ_MCP_WRITE_TOKENS=
# HOMEIQ_MCP_ALLOW_WRITES=
# HOMEIQ_MCP_ALLOWED_HOSTS=host.docker.internal
# HOMEIQ_MCP_BIND=172.20.0.1   # publish only on the docker gateway AgentForge dials
# HOMEIQ_MCP_LAN_BIND=         # second publish, on the host LAN address the Home
#                              # Assistant integration dials (TAP-5305..5309). Leave
#                              # unset to keep the MCP off the LAN. Must differ from
#                              # HOMEIQ_MCP_BIND, and the address must also appear in
#                              # HOMEIQ_MCP_ALLOWED_HOSTS or the Host check rejects it.

# HA host SSH — the agent's write path to /config (TAP-5430, TAP-6018). Provision by
# adding a dedicated public key to the core_ssh add-on's authorized_keys and publishing
# its 22/tcp port (see docs/deployment/DEPLOYMENT_RUNBOOK.md). Path only; never the key.
# HOMEIQ_HA_SSH_KEY=~/.ssh/homeiq_agent_ed25519
# HOMEIQ_HA_SSH_HOST=192.168.1.80
# HOMEIQ_HA_SSH_PORT=22222
# HOMEIQ_HA_SSH_USER=root

# admin-api key (defaults to API_KEY when unset)
# ADMIN_API_API_KEY=
# ha-ai-agent-service key
# HA_AGENT_API_KEY=

# JWT auth (admin-api)
JWT_SECRET_KEY=
ADMIN_PASSWORD=
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# ENABLE_AUTH=false

# Gates remote secret writes via admin-api config endpoints.
# Default false: keep it false unless you explicitly need remote env editing.
# ADMIN_API_ALLOW_SECRET_WRITES=false

# Device-database service credentials (optional)
# DEVICE_DATABASE_API_URL=
# DEVICE_DATABASE_API_KEY=


# =============================================================================
# 5. LLM PROVIDERS
# =============================================================================
# REQUIRED: ha-ai-agent-service refuses to boot without OPENAI_API_KEY
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=            # optional (Claude-backed features)
# OPENAI_MODEL=gpt-5-mini
# OPENAI_YAML_MODEL=gpt-5.2-codex


# =============================================================================
# 6. EXTERNAL DATA SERVICES (enable only what you use)
# =============================================================================
# Weather (OpenWeatherMap)
WEATHER_API_KEY=
# WEATHER_API_URL=https://api.openweathermap.org/data/2.5
# WEATHER_LOCATION=Las Vegas,NV,US
# WEATHER_DEFAULT_LOCATION=Las Vegas,NV,US
# WEATHER_ENRICHMENT_ENABLED=true
# WEATHER_CACHE_MINUTES=15
# WEATHER_RATE_LIMIT_PER_MINUTE=50
# WEATHER_RATE_LIMIT_PER_DAY=900
# WEATHER_REQUEST_TIMEOUT=10

# Air quality (AirNow — falls back to OpenWeather when unset)
# AIRNOW_API_KEY=

# Electricity pricing
# PRICING_PROVIDER=awattar
# PRICING_API_KEY=

# Smart meter (home_assistant | emporia | sense | generic)
# METER_TYPE=home_assistant
# METER_API_TOKEN=
# METER_DEVICE_ID=

# Location (air quality / sun / weather calculations)
LATITUDE=36.1699
LONGITUDE=-115.1398

# Calendar service (HA calendar entities, comma-separated)
CALENDAR_ENTITIES=calendar.primary
# CALENDAR_FETCH_INTERVAL=900

# Sports (Team Tracker polling)
# SPORTS_POLL_INTERVAL=60

# GitHub token (blueprint/community miners — raises rate limits)
# GITHUB_TOKEN=
# DISCOURSE_MIN_LIKES=5

# Feature flags for external services
# ENABLE_WEATHER_API=false
# ENABLE_ELECTRICITY_PRICING=false
# ENABLE_AIR_QUALITY=false
# ENABLE_SMART_METER=false
# ENABLE_SPORTS_DATA=false


# =============================================================================
# 7. MQTT / ZIGBEE2MQTT (only if using MQTT integrations)
# =============================================================================
# Full broker URL including scheme and port, e.g. mqtt://your-broker:1883
MQTT_BROKER=
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# ZIGBEE2MQTT_BASE_TOPIC=zigbee2mqtt


# =============================================================================
# 8. OPS / RUNTIME
# =============================================================================
# LOG_LEVEL=INFO
# LOG_FILE_PATH=/app/logs
TZ=America/Los_Angeles
# Deployment mode: production | test
DEPLOYMENT_MODE=production
# OpenTelemetry collector endpoint (observability, optional)
# OTLP_ENDPOINT=
# RELOAD=false
# ENABLE_CACHING=true

# WebSocket retry tuning (websocket-ingestion; -1 = retry forever)
# WEBSOCKET_MAX_RETRIES=-1
# WEBSOCKET_MAX_RETRY_DELAY=300
# WS_PING_INTERVAL=30
# WS_RECONNECT_DELAY=5

# Generic client tuning (various services)
# TIMEOUT=30
# MAX_RETRIES=3
# RETRY_DELAY=5
# MAX_WORKERS=4
# QUERY_TIMEOUT=30
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_TIMEOUT=60

# Data retention / backup
# CLEANUP_INTERVAL_HOURS=24
# MONITORING_INTERVAL_MINUTES=5
# COMPRESSION_INTERVAL_HOURS=24
# BACKUP_INTERVAL_HOURS=24
# BACKUP_DIR=/backups
# S3 archival (optional)
# S3_ARCHIVE_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Named volumes / paths (compose overrides, rarely needed)
# HOMEIQ_LOGS_VOLUME=homeiq_logs
# AI_AUTOMATION_DATA_VOLUME=ai_automation_data
# AI_AUTOMATION_MODELS_VOLUME=ai_automation_models


# =============================================================================
# 9. SERVICE-SPECIFIC TUNING (defaults are fine for most installs)
# =============================================================================
# Device management service ports
# DEVICE_HEALTH_MONITOR_PORT=8019
# DEVICE_INTELLIGENCE_PORT=8019
# DEVICE_INTELLIGENCE_HOST=0.0.0.0
# DEVICE_SETUP_ASSISTANT_PORT=8021
# DEVICE_RECOMMENDER_PORT=8022
# DEVICE_DATABASE_CLIENT_PORT=8023
# DEVICE_CONTEXT_CLASSIFIER_PORT=8036
# DEVICE_CACHE_DIR=/app/data/cache
# DEVICE_BLACKLIST_PATTERNS=
# DEFAULT_NOTIFY_SERVICE=
# STORE_DEVICE_HISTORY_IN_INFLUXDB=false

# Data API
# DATA_API_URL=http://data-api:8006

# ML engine
# ML_USE_INCREMENTAL=false
# ML_INCREMENTAL_UPDATE_THRESHOLD=100
# ML_FAILURE_MODEL=
# GNN_USE_COMPILE=false
# CAPABILITY_GRAPH_REFRESH_INTERVAL=3600
# CAPABILITY_GRAPH_CACHE_TTL=300

# Automation tracing / logbook polling
# TRACE_POLL_INTERVAL_SECONDS=60
# LOGBOOK_POLL_INTERVAL_SECONDS=60

# Blueprint miner scheduler
# SCHEDULER_ENABLED=true
# SCHEDULER_TIME=03:00

# Network monitoring (optional)
# ZEEK_INTERFACE=eth0


# =============================================================================
# 10. DEV / SIMULATOR (ignored in production)
# =============================================================================
# SIMULATOR_PORT=8123
# SIMULATOR_AUTH_TOKEN=dev_simulator_token
# SIMULATOR_HA_VERSION=2025.10.1
# SIMULATOR_LOG_LEVEL=INFO
# ENABLE_SYNTHETIC_DATA_GENERATION=false
# ENABLE_MOCK_DATA_CREATION=false

# AgentForge project bearer (TAP-5902: required — its loss killed the integration)
# AGENTFORGE_API_KEY=

# Grafana admin password (required since TAP-5993 — no committed default)
GF_SECURITY_ADMIN_PASSWORD=

# Host docker group GID for admin-api socket access (getent group docker | cut -d: -f3)
DOCKER_GID=984

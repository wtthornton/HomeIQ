# .env.ci — CI-only placeholder values for docker compose interpolation.
#
# These are NOT secrets. They exist solely so `docker compose config` and
# `docker compose build` can resolve the `${VAR:?required}` interpolations
# declared in docker-compose.yml / domains/*/compose.yml without a real
# .env file present (CI checks out a clean tree; .env is gitignored).
#
# Building container images never reads these values at runtime — they only
# satisfy Compose's interpolation step so `config` / `build` can succeed.
# Never put real credentials in this file; it is committed to the repo.
ADMIN_API_JWT_SECRET=ci-placeholder-not-a-secret
ADMIN_PASSWORD=ci-placeholder-not-a-secret
GF_SECURITY_ADMIN_PASSWORD=ci-placeholder-not-a-secret
HOMEIQ_MCP_READ_TOKENS=ci-placeholder-not-a-secret
INFLUXDB_PASSWORD=ci-placeholder-not-a-secret
INFLUXDB_TOKEN=ci-placeholder-not-a-secret
POSTGRES_PASSWORD=ci-placeholder-not-a-secret

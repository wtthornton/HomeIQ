# Machine-local caches (content hashes / project profile) — not shared state.
# .tapps-mcp/memory/ stays tracked.
.tapps-mcp/af-publish-cache.json
.tapps-mcp/profile-cache.json

# AgentForge kit skills/rules are absolute symlinks into a local AgentForge
# clone, created per-machine by install_kit.sh. Committing them would leave
# every other clone with dangling links. See docs/AF-INTEGRATION.md § Setup.
.claude/skills/af-*
.claude/rules/af-integration.mdc
.cursor/skills/af-*
.cursor/rules/af-integration.mdc

# ML model binaries (regenerated at deploy time)
*.pkl
!**/tests/**/*.pkl
# Timestamped copies predictive_analytics.py writes before overwriting a
# model (and predictions_router.py reads back). Real behaviour, but running
# the suite leaves them in the working tree, and .pkl.backup_<ts> does not
# match the *.pkl rule above. Not path-scoped: the previous rule only covered
# the service directory, so a run with a different working directory dropped
# an unignored copy elsewhere.
*.pkl.backup_[0-9]*
model_metadata.json.backup_[0-9]*
# Generated at train time (TAP-6242): tracking it made every test run dirty
# the working tree with fresh timestamps.
domains/ml-engine/device-intelligence-service/models/model_metadata.json
.tapps-mcp/backups/
.tapps-mcp/hook-backups/
.tapps-mcp/.lookup-docs-events.jsonl
.tapps-mcp/test-edges-index.json

# HA agent baselines: a capture of a real home's registries (device, area and
# entity names). Testing artefact, never commit.
ha-baseline*.json

# Nightly init-agent audit artifacts and inventory sweeps: same data class as
# the baselines (real IEEE addresses, coordinator IP, area/device/entity
# names). Regenerated from the live instance — never commit.
.tapps-mcp/init-audit-*.json
.tapps-mcp/init-audit-cron.log
.tapps-mcp/init-agent-baseline-*.json
.tapps-mcp/org-inventory-*.json
.tapps-mcp/office-inventory-*.json
.tapps-mcp/org-author-run-*.json
.tapps-mcp/sg2-slugs-*.json

# TappsMCP per-directory tool caches minted outside the root .tapps-mcp/
# (session ledgers, call-graph indices) — machine-local, never commit.
# (*/**/ = any depth below root; the root .tapps-mcp/ holds tracked files.)
*/**/.tapps-mcp/
.tapps-mcp/sessions/
.tapps-mcp/metrics/

# Runtime state on the config bind mount: flow keys embed hardware
# identity (MACs/serials) that must never enter a public repo history.
config/init-triage.json

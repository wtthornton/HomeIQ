      }
    },
    "nlt-memory": {
      "type": "streamableHttp",
      "url": "http://127.0.0.1:8761/mcp",
      "headers": {
        "X-Tapps-Project-Root": "/home/wtthornton/code/HomeIQ"
      }
    },
    "nlt-setup": {
      "type": "streamableHttp",
      "url": "http://127.0.0.1:8762/mcp",
      "headers": {
        "X-Tapps-Project-Root": "/home/wtthornton/code/HomeIQ"
      }
    },
    "nlt-linear-issues": {
      "type": "streamableHttp",
      "url": "http://127.0.0.1:8763/mcp",
      "headers": {
        "X-Tapps-Project-Root": "/home/wtthornton/code/HomeIQ"
      }
    },
    "nlt-project-docs": {
      "type": "streamableHttp",
      "url": "http://127.0.0.1:8764/mcp",
      "headers": {
        "X-Tapps-Project-Root": "/home/wtthornton/code/HomeIQ"
      }
    },
    "nlt-release-ship": {
      "type": "streamableHttp",
      "url": "http://127.0.0.1:8765/mcp",
      "headers": {
        "X-Tapps-Project-Root": "/home/wtthornton/code/HomeIQ"
      }
    },
    "Playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "FileSystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/wtthornton/code/HomeIQ"
      ]
    },
    "GitHub": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
    "agentforge": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "/home/wtthornton/code/AgentForge/clients/agentforge-mcp",
        "agentforge-mcp"
      ],
      "env": {
        "AGENTFORGE_URL": "http://localhost:8010",
        "AGENTFORGE_PROJECT_SLUG": "homeiq",
        "AGENTFORGE_LOAD_DOTENV": "1",
        "AGENTFORGE_MCP_PROFILE": "runtime"
      }
    }
  }
}
